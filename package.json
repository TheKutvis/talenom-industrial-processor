{
  "name": "talenom-general-ledger-client",
  "version": "2.0.0",
  "description": "Node.js client for Talenom General Ledger API with industrial-style UI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pkg . --targets node18-win-x64 --output dist/TalenomToolbox.exe"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "services/**/*",
      "templates/**/*",
      "utils/**/*",
      "general-ledger-fi.json",
      "node_modules/xlsx/**/*",
      "node_modules/axios/dist/**/*"
    ],
    "scripts": [
      "services/**/*.js",
      "utils/**/*.js",
      "node_modules/axios/**/*.js"
    ],
    "outputPath": "dist",
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "talenom",
    "general-ledger",
    "accounting",
    "api-client",
    "oauth2"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
