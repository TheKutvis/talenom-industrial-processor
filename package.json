{
  "name": "talenom-general-ledger-client",
  "version": "2.0.0",
  "description": "Node.js client for Talenom General Ledger API with industrial-style UI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node build-simple.js",
    "build:simple": "node build-simple.js",
    "build:sea": "node build-sea-improved.js",
    "build:sea-original": "node build-sea.js",
    "build:bun": "node build-bun.js",
    "build:caxa": "node build-caxa.js",
    "build:legacy": "pkg . --targets node18-win-x64 --output dist/TalenomToolbox.exe",
    "build:all": "npm run build:simple && npm run build:sea && npm run build:bun",
    "prebuild": "echo '🏗️  Starting build process...'",
    "postbuild": "echo '✅ Build completed!'"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "services/**/*",
      "templates/**/*",
      "utils/**/*",
      "general-ledger-fi.json",
      "node_modules/xlsx/**/*",
      "node_modules/axios/dist/**/*"
    ],
    "scripts": [
      "services/**/*.js",
      "utils/**/*.js",
      "node_modules/axios/**/*.js"
    ],
    "outputPath": "dist",
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "talenom",
    "general-ledger",
    "accounting",
    "api-client",
    "oauth2"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "winston": "^3.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
